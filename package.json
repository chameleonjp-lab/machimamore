{
  "name": "machimamore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "evidence:source": "node scripts/source-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "test:balance": "tsx scripts/balance.ts",
    "test:review": "node --import tsx scripts/review-rounded-box-equivalence.ts && node --import tsx scripts/review-ir10-fixtures.ts",
    "test:evidence": "node scripts/review-balance-evidence.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.19.1",
    "@types/three": "0.183.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
